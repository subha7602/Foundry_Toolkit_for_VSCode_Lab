# Local workshop environment variables (do not commit real secrets)
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Option A: Groq Cloud (Recommended: Ultra-fast Multi-Agent Inference) ---
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# --- Option B: OpenRouter Gateway (200+ Models: Claude, DeepSeek, GPT-4o) ---
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# --- Option C: Microsoft Azure AI Foundry ---
AZURE_FOUNDRY_ENDPOINT="https://<your-resource-name>.services.ai.azure.com/api/projects/<your-project-name>"
AZURE_FOUNDRY_API_KEY="<your-azure-key>"
AZURE_FOUNDRY_DEPLOYMENT_NAME="gpt-5.4-mini"
AZURE_FOUNDRY_API_VERSION="2024-10-21"
MICROSOFT_LEARN_MCP_ENDPOINT="https://learn.microsoft.com/api/mcp"

